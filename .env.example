# Copy this file to .env and fill in your own values. Do not commit .env.

# Local IP address of your Samsung Frame TV
TV_IP=192.168.1.10

# URL that serves the image to display (e.g. a fugleramme instance: https://github.com/arnegiacomo/fugleramme)
SOURCE_URL=http://192.168.1.20:8080/collage.png

# Samsung Frame TV Art Mode port (usually no need to change)
TV_PORT=8002

# How often to fetch and upload the image, in seconds
SYNC_INTERVAL=3600

# HTTP request timeout when fetching the source image, in seconds
REQUEST_TIMEOUT=10

# Target canvas size the image is padded to (should match your TV's resolution)
FRAME_WIDTH=3840
FRAME_HEIGHT=2160

# Background color used to pad images that don't match the frame's aspect ratio,
# instead of letting the TV stretch them
FRAME_BACKGROUND_COLOR=#f2ede2

# Whether to select the uploaded image as the active Art Mode picture (true/false)
AUTO_SELECT_IMAGE=true

# Directory where the last uploaded image's content id is persisted, so it
# can be deleted (rather than accumulating) on the next sync after a restart
DATA_DIR=data

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
